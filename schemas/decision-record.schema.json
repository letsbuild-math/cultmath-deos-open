{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/letsbuild-math/cultmath-deos-open/main/schemas/decision-record.schema.json",
  "title": "Decision Record",
  "description": "A decision written so someone who was not in the room can say what was decided, why, what it cost and what would change it. Standard: C1 Decision Record (core/C01_decision_record.md). DEOS Open · Ipalibo Da-Wariboko · CULT+MATH LLC · MIT.",
  "type": "object",
  "required": [
    "decision",
    "status",
    "date",
    "decided_by",
    "evidence",
    "tradeoff",
    "trigger_for_reconsideration"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "minLength": 10,
      "description": "One sentence, active voice."
    },
    "status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "DECIDED",
        "PENDING",
        "DEFERRED",
        "REVISED"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "decided_by": {
      "type": "string",
      "minLength": 2,
      "description": "Name or role."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 3,
            "description": "Where it came from: a title, a document name, a data set."
          },
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "Link, if there is one."
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          }
        }
      },
      "description": "Named, linked evidence. Not a summary."
    },
    "tradeoff": {
      "type": "string",
      "minLength": 10,
      "description": "What this gives up. Every real decision gives something up."
    },
    "trigger_for_reconsideration": {
      "type": "string",
      "minLength": 10,
      "description": "The specific fact, date or number that would reopen it."
    },
    "replaces": {
      "type": "string",
      "description": "The record this one replaces, if any."
    },
    "replaced_by": {
      "type": "string",
      "description": "Set when status is REVISED."
    }
  },
  "additionalProperties": false
}
