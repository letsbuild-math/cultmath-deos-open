{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/letsbuild-math/cultmath-deos-open/main/schemas/gate.schema.json",
  "title": "Gate",
  "description": "A pass/fail check with its threshold's basis and proof that it can fail. Standard: C5 Gate (core/C05_gate.md). DEOS Open · Ipalibo Da-Wariboko · CULT+MATH LLC · MIT.",
  "type": "object",
  "required": [
    "name",
    "rule",
    "threshold",
    "checked_on_real_case",
    "failing_case_fires",
    "result"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "description": "Gate name."
    },
    "rule": {
      "type": "string",
      "minLength": 10,
      "description": "The rule in one sentence."
    },
    "threshold": {
      "type": "object",
      "required": [
        "value",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "parity",
            "observed_range",
            "published_benchmark",
            "commercial_floor"
          ]
        },
        "basis_detail": {
          "type": "string",
          "description": "Which benchmark, which range, which floor."
        }
      }
    },
    "checked_on_real_case": {
      "type": "object",
      "required": [
        "case",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "case": {
          "type": "string",
          "minLength": 2,
          "description": "The real case."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "What the check printed."
        }
      }
    },
    "failing_case_fires": {
      "type": "object",
      "required": [
        "case",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "case": {
          "type": "string",
          "minLength": 2,
          "description": "A case built to fail."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "What the check printed. It must show a failure."
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    },
    "result_output": {
      "type": "string",
      "description": "What the gate printed on the real run."
    },
    "if_failed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defect": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        },
        "rebuilt_gate_registered": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD"
        }
      }
    }
  },
  "additionalProperties": false
}
